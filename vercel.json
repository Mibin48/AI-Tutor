{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/audio/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/motions/(.*)",
      "destination": "/assets/motions/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
